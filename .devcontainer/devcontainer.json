{
  "name": "Basalt Jammy",
  "build": {
    "context": "..",
    "dockerfile": "../docker/b_image_jammy/Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "root",
  "containerEnv": {
    "CCACHE_DIR": "/workspaces/.ccache",
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1"
  },
  "mounts": [
    "source=basalt-ccache,target=/workspaces/.ccache,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/home/dm/data,target=/home/dm/data,type=bind"
  ],
  "runArgs": [
    "--privileged",
    "--network=host",
    "--ipc=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "xaver.clang-format",
        "llvm-vs-code-extensions.vscode-clangd",
        "openai.chatgpt"
      ],
      "settings": {
        "C_Cpp.clang_format_path": "/usr/bin/clang-format-18",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
        "C_Cpp.default.compilerPath": "/usr/bin/clang++-18",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureSettings": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "CMAKE_C_COMPILER": "/usr/bin/clang-18",
          "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18"
        },
        "cmake.generator": "Unix Makefiles",
        "editor.formatOnSave": true,
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build",
          "--completion-style=detailed",
          "--clang-tidy",
          "--clang-tidy-checks=-*,modernize*",
          "--header-insertion=never",
          "--background-index"
        ]
      }
    }
  },
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}